import os

projectName = 'cssdm'

sourceFiles = [
	'cssdm_main.cpp',
	'cssdm_config.cpp',
	'cssdm_callbacks.cpp',
	'cssdm_ctrl.cpp',
	'cssdm_detours.cpp',
	'cssdm_events.cpp',
	'cssdm_weapons.cpp',
	'cssdm_players.cpp',
	'cssdm_ffa.cpp',
	'cssdm_utils.cpp',
]

project = builder.LibraryProject(projectName)

if os.path.isfile(os.path.join(builder.currentSourcePath, 'sdk', 'smsdk_ext.cpp')):
	project.sources += [os.path.join('sdk', 'smsdk_ext.cpp')]
else:
	project.sources += [os.path.join(Extension.sm_root, 'public', 'smsdk_ext.cpp')]

project.sources += sourceFiles

for sdk_target in Extension.sdk_targets:
	sdk = sdk_target.sdk
	cxx = sdk_target.cxx
	if sdk['name'] in ['mock']:
		continue

	binary = Extension.HL2ExtConfig(project, builder, cxx, projectName + '.ext.' + sdk['extension'], sdk)
	Extension.auto_version(binary)
	Extension.add_cdetour(binary)

Extension.extensions += builder.Add(project)
