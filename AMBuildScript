import os
import platform

def ResolveEnvPath(env, folder):
	if env in os.environ:
		path = os.environ[env]
		if os.path.isdir(path):
			return path
		return None

	head = os.getcwd()
	oldhead = None
	while head != None and head != oldhead:
		path = os.path.join(head, folder)
		if os.path.isdir(path):
			return path
		oldhead = head
		head, tail = os.path.split(head)

	return None

def Normalize(path):
	return os.path.abspath(os.path.normpath(path))

class ExtensionConfig(object):
	def __init__(self):
		self.sm_bin_root = None
		self.spcomp = None
		self.plugins = {}

	def find_spcomp(self):
		exe_suffix = "" if not os.name == "nt" else ".exe"
		if builder.options.sm_bin_path:
			sm_bin_root = builder.options.sm_bin_path
		else:
			sm_bin_root = ResolveEnvPath("SOURCEMOD_BIN", "sourcemod-bin")
		if not sm_bin_root or not os.path.isdir(sm_bin_root):
			raise Exception("Could not find a binary copy of SourceMod")
		self.sm_bin_root = Normalize(sm_bin_root)
		spcomp_path = os.path.join(self.sm_bin_root, "addons", "sourcemod", "scripting", "spcomp" + exe_suffix)
		spcomp64_path = os.path.join(self.sm_bin_root, "addons", "sourcemod", "scripting", "spcomp64" + exe_suffix)
		is_64bit = platform.architecture()[0].lower() == "64bit"
		if os.path.isfile(spcomp64_path) and is_64bit:
			self.spcomp = Normalize(spcomp64_path)
		elif os.path.isfile(spcomp_path):
			self.spcomp = Normalize(spcomp_path)
		else:
			raise Exception("Could not find a suitable copy of spcomp in SourceMod binary root")

Extension = ExtensionConfig()
Extension.find_spcomp()

BuildScripts = [
	'scripting/AMBuilder',
	'PackageScript',
]

builder.Build(BuildScripts, { 'Extension': Extension })
