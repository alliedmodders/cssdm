import os

builder.SetBuildFolder('package')

folder_list = [
	'cfg/cssdm',
	'cfg/cssdm/extra',
	'cfg/cssdm/maps',
	'cfg/cssdm/spawns',
	'cfg/cssdm/spawns/cstrike',
	'cfg/cssdm/spawns/csgo',
	'addons/sourcemod/plugins',
	'addons/sourcemod/plugins/cssdm',
	'addons/sourcemod/scripting',
	'addons/sourcemod/scripting/include',
	'addons/sourcemod/gamedata',
	'addons/sourcemod/translations'
]

# Create the distribution folder hierarchy.
folder_map = {}
for folder in folder_list:
	norm_folder = os.path.normpath(folder)
	folder_map[folder] = builder.AddFolder(norm_folder)

# Do all straight-up file copies from the source tree.
def CopyFiles(src, dest, files):
	if not dest:
		dest = src
	dest_entry = folder_map[dest]
	for source_file in files:
		source_path = os.path.join(builder.sourcePath, src, source_file)
		builder.AddCopy(source_path, dest_entry)

def CopyDirectory(src, dest):
	if not dest:
		dest = src
	dest_entry = folder_map[dest]
	source_path = os.path.join(builder.sourcePath, src)
	for entry in os.listdir(source_path):
		entry_path = os.path.join(source_path, entry)
		if not os.path.isfile(entry_path):
			continue
		builder.AddCopy(entry_path, dest_entry)

# Include files 
CopyFiles('scripting/include', 'addons/sourcemod/scripting/include', [
	'cssdm.inc'
])

# Script sources
CopyFiles('scripting', 'addons/sourcemod/scripting', [
	'dm_base.sp',
	'dm_basics.sp',
	'dm_bot_quotas.sp',
	'dm_equipment.sp',
	'dm_preset_spawns.sp',
	'dm_spawn_protection.sp'
])

# GameData files
CopyFiles('gamedata', 'addons/sourcemod/gamedata', [
	'cssdm.games.txt'
])

# Config files
CopyFiles('cfg', 'cfg/cssdm', [
	'cssdm.cfg',
	'cssdm.equip.txt',
	'cssdm.weapons.txt'
])

CopyFiles('.', 'cfg/cssdm/extra', [
	'changelog.txt',
	'credits.txt',
	'license.txt'
])

CopyDirectory('translations', 'addons/sourcemod/translations')
CopyDirectory('cfg/spawns/cstrike', 'cfg/cssdm/spawns/cstrike')
CopyDirectory('cfg/spawns/csgo', 'cfg/cssdm/spawns/csgo')

base_translations_dir = os.path.join(builder.sourcePath, 'translations')
for entry in os.listdir(base_translations_dir):
	entry_path = os.path.join(base_translations_dir, entry)
	if not os.path.isdir(entry_path):
		continue
	dest_entry = os.path.join('addons', 'sourcemod', 'translations', entry)
	folder_map[dest_entry] = builder.AddFolder(dest_entry)
	CopyDirectory(os.path.join('translations', entry), dest_entry)

# Copy plugins
for smx_file, smx_entry in Extension.plugins.items():
	builder.AddCopy(smx_entry, folder_map['addons/sourcemod/plugins/cssdm'])
